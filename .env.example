NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for /admin/admins/new and accurate 비밀번호 찾기 account lookup. Never expose to the browser.
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Dashboard → Authentication → URL Configuration: add redirect URLs
#   https://your-domain/auth/callback
#   https://your-domain/login/reset-password
# Set to true for local UI development without Supabase
VEHICLE_DETAIL_USE_MOCK=false
